# SOURCE DCS Website — Environment Variables
# Copy this file to .env and fill in your values for local development.
# In production, set these as actual environment variables (not a .env file).

# Express server port
PORT=3000

# Casdoor application credentials
# Client ID from the Casdoor application you created (Applications → your app → Client ID)
CASDOOR_CLIENT_ID=sourcedcs-web

# Base URL of your Casdoor instance (no trailing slash)
CASDOOR_ENDPOINT=https://auth.sourcedcs.page
