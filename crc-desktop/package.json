{
  "name": "crc-desktop",
  "version": "1.0.1",
  "description": "CRC — SOURCE DCS's desktop GCI/datalink client for DCS: World",
  "author": "SOURCE DCS",
  "desktopName": "CRC.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack:linux": "electron-builder --linux AppImage --publish never",
    "pack:win":   "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "page.sourcedcs.crc",
    "productName": "CRC",
    "directories": {
      "output": "dist",
      "app": "."
    },
    "files": [
      "package.json",
      "main.js",
      "config.json",
      "app/**/*",
      "!app/package.json",
      "!app/package-lock.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "synopsis": "SOURCE DCS GCI/datalink client",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "python-pkg",
          "to": "python-pkg",
          "filter": ["**/*"]
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sourcedcs.page/downloads"
      }
    ]
  }
}
