# ── SOURCE DCS — environment variables ──────────────────────────────────────
# Copy this file to infra/.env (next to docker-compose.yml) and fill in values.

# ── Web server ───────────────────────────────────────────────────────────────
PORT=7000

# ── Casdoor OAuth (shared) ───────────────────────────────────────────────────
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_SECRET=

# ── Casdoor OAuth — sourcedcs-web client ────────────────────────────────────
CASDOOR_CLIENT_ID=

# ── Casdoor OAuth — atobrief client ─────────────────────────────────────────
ATOBRIEF_CLIENT_ID=
ATOBRIEF_CLIENT_SECRET=

# ── Casdoor OAuth — crc-sync client ─────────────────────────────────────────
CRCSYNC_CLIENT_ID=
CRCSYNC_CLIENT_SECRET=

# ── crc-desktop release uploads ──────────────────────────────────────────────
# Shared secret the crc-desktop-release GitHub Actions workflow uses to
# upload installers/manifests to sourcedcs-web's /api/releases/upload —
# also set as the RELEASES_UPLOAD_TOKEN repo secret in GitHub.
RELEASES_UPLOAD_TOKEN=

# ── Domains ───────────────────────────────────────────────────────────────────
DOMAIN=
WIKI_DOMAIN=
AUTH_DOMAIN=
ATOBRIEF_DOMAIN=
ASACS_DOMAIN=

# ── External links (shown on the site) ───────────────────────────────────────
DISCORD_URL=https://discord.gg/sourcedcs
WIKI_URL=https://wiki.sourcedcs.page
ATO_URL=https://ato.sourcedcs.page
OLYMPUS_URL=https://olympus.sourcedcs.page
ASACS_URL=https://asacs.sourcedcs.page
GITHUB_URL=https://github.com/NikNam3/sourcedcs

# ── crc-sync — DCS-gRPC / SRS upstream ──────────────────────────────────────
# crc-sync is the sole gRPC + SRS client on behalf of every crc-desktop
# instance (see crc-sync/). Defaults match the shared DCS server; only
# override if crc-sync needs to point somewhere else.
CRCSYNC_DCS_GRPC_HOST=server.sourcedcs.page:50051
CRCSYNC_SRS_HOST=server.sourcedcs.page
CRCSYNC_SRS_PORT=5002

# ── Discord bot ───────────────────────────────────────────────────────────────
# Bot token — required for live roster fetching and application notifications.
DISCORD_BOT_TOKEN=

# Guild (server) ID — required for live roster fetching.
DISCORD_GUILD_ID=

# Channel ID where new applications are posted as embeds.
# If not set, applications fall back to local JSON storage.
APPLY_CHANNEL_ID=
